rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function isMember(teamId) {
      return signedIn() && request.auth.uid in get(teamPath(teamId)).data.memberIds;
    }
    // getAfter: membership as it will be once the current batch commits —
    // lets the join batch create the member doc it is authorising itself with.
    function isMemberAfter(teamId) {
      return signedIn() && request.auth.uid in getAfter(teamPath(teamId)).data.memberIds;
    }
    function isCaptain(teamId) {
      return signedIn() && get(teamPath(teamId)).data.createdBy == request.auth.uid;
    }

    // F1: users may only touch their own profile doc (MVP-SPEC §2.3 fields;
    // v1.2 adds aiMealsEnabled + mealPrefs).
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['activeTeamId', 'units', 'theme', 'aiMealsEnabled', 'mealPrefs', 'createdAt']);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeTeamId', 'units', 'theme', 'aiMealsEnabled', 'mealPrefs']);

      // F11 (v1.2): meals are private to their owner — the team only ever
      // sees function-written aggregates (teams/{id}/fuelling).
      match /meals/{mealId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['date', 'slot', 'libraryRefId', 'textSnapshot', 'portionNote', 'tag', 'status', 'loggedAt', 'createdAt'])
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && request.resource.data.slot in ['breakfast', 'lunch', 'dinner', 'snack', 'during']
          && request.resource.data.status in ['logged', 'draft']
          && request.resource.data.libraryRefId is string
          && request.resource.data.textSnapshot is string
          && request.resource.data.textSnapshot.size() >= 1
          && request.resource.data.textSnapshot.size() <= 200
          && (!('portionNote' in request.resource.data) || request.resource.data.portionNote.size() <= 120)
          && (!('tag' in request.resource.data) || request.resource.data.tag in ['carb', 'protein', 'light'])
          && request.resource.data.loggedAt is timestamp;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['date', 'slot', 'libraryRefId', 'textSnapshot', 'portionNote', 'tag', 'status', 'loggedAt']);
      }

      // Library shape is enforced client-side; owner-only is the boundary.
      match /mealLibrary/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // F12: personal templates (session + mealDay + exercise presets).
      match /templates/{templateId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['kind', 'name', 'payload', 'useCount', 'createdFrom', 'createdAt'])
          && request.resource.data.kind in ['session', 'mealDay', 'exercise']
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60;
      }

      // F13: function-written AI surfaces — owner reads, clients never write.
      match /mealPlans/{weekId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /nutritionReviews/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // F2 (§2.5 Spark design): membership is guarded here, not by a function.
    match /teams/{teamId} {
      allow get: if isMember(teamId);
      allow list: if false;
      allow delete: if false;

      // Creator becomes captain and sole member, atomically with the invite doc.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'eventDistanceKm', 'eventDate', 'createdBy', 'inviteCode', 'memberIds', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.eventDistanceKm in [18, 30, 48, 96]
        && request.resource.data.eventDate is timestamp
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6;

      // Captain edits metadata; a joiner may only append their own uid,
      // to a team with space (2–5 members, spec §1.2).
      allow update: if signedIn() && (
        (
          isCaptain(teamId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'eventDistanceKm', 'eventDate', 'inviteCode'])
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 40
          && request.resource.data.eventDistanceKm in [18, 30, 48, 96]
          && request.resource.data.inviteCode.size() == 6
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 5
        )
      );

      match /members/{uid} {
        allow read: if isMember(teamId);
        allow delete: if false;
        allow create: if signedIn()
          && request.auth.uid == uid
          && isMemberAfter(teamId)
          && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'isCaptain', 'weeklyTargetHours', 'joinedAt'])
          && request.resource.data.isCaptain == (getAfter(teamPath(teamId)).data.createdBy == uid);
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'photoURL', 'weeklyTargetHours']);
      }

      // F3: members log their own sessions; bounds mirror the Yup schemas.
      match /sessions/{sessionId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'type', 'source', 'startedAt', 'durationMin', 'distanceKm', 'elevationGainM', 'avgPaceMinPerKm', 'route', 'exercises', 'perceivedEffort', 'notes', 'weekKey', 'createdAt'])
          && request.resource.data.type in ['hike', 'run', 'walk', 'stairs', 'strength', 'other']
          && request.resource.data.source in ['gps', 'manual']
          && request.resource.data.startedAt is timestamp
          && request.resource.data.durationMin is number
          && request.resource.data.durationMin >= 1
          && request.resource.data.durationMin <= 1440
          && (!('distanceKm' in request.resource.data) || (request.resource.data.distanceKm >= 0 && request.resource.data.distanceKm <= 100))
          && (!('elevationGainM' in request.resource.data) || (request.resource.data.elevationGainM >= 0 && request.resource.data.elevationGainM <= 5000))
          && (!('exercises' in request.resource.data) || (request.resource.data.exercises is list && request.resource.data.exercises.size() <= 20))
          && request.resource.data.perceivedEffort is int
          && request.resource.data.perceivedEffort >= 1
          && request.resource.data.perceivedEffort <= 10
          && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500)
          && request.resource.data.weekKey is string;
        allow update: if isMember(teamId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember(teamId) && resource.data.uid == request.auth.uid;
      }

      // F5/F9/F10: AI plans are function-written (Admin SDK bypasses rules);
      // captains may additionally hand-write a 'manual' plan and supersede
      // the previous active one — nothing else is client-writable.
      match /plans/{planId} {
        allow read: if isMember(teamId);
        allow delete: if false;
        allow create: if isCaptain(teamId)
          && request.resource.data.keys().hasOnly(['generatedAt', 'model', 'promptVersion', 'phase', 'weekKey', 'status', 'readinessInputs', 'days'])
          && request.resource.data.model == 'manual'
          && request.resource.data.status == 'active'
          && request.resource.data.weekKey is string
          && request.resource.data.days is list
          && request.resource.data.days.size() >= 1
          && request.resource.data.days.size() <= 60;
        allow update: if isCaptain(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'superseded';

        // Members tick their own items done (F5 check-offs).
        match /checkoffs/{checkId} {
          allow read: if isMember(teamId);
          allow create, update: if isMember(teamId)
            && request.resource.data.uid == request.auth.uid
            && checkId == request.auth.uid + '_' + string(request.resource.data.dayIndex)
            && request.resource.data.keys().hasOnly(['uid', 'dayIndex', 'done', 'updatedAt']);
          allow delete: if false;
        }
      }

      // F5 (§2.5): plan-generation request queue. Captain creates a pending
      // request; the onPlanRequest trigger (Admin SDK) claims it and writes
      // the outcome — clients can only create, never mutate.
      match /planRequests/{requestId} {
        allow read: if isMember(teamId);
        allow create: if isCaptain(teamId)
          && request.resource.data.keys().hasOnly(['requestedBy', 'status', 'createdAt'])
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /memberMetrics/{metricId} {
        allow read: if isMember(teamId);
        allow write: if false;
      }

      match /suggestions/{weekKey} {
        allow read: if isMember(teamId);
        allow write: if false;
      }

      // F12: team templates — readable by members, curated by the captain.
      match /templates/{templateId} {
        allow read: if isMember(teamId);
        allow delete: if isCaptain(teamId);
        allow create, update: if isCaptain(teamId)
          && request.resource.data.keys().hasOnly(['kind', 'name', 'payload', 'useCount', 'createdFrom', 'createdAt'])
          && request.resource.data.kind in ['session', 'mealDay', 'exercise']
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60;
      }

      // F13A: meal plan generation queue (same org-policy-safe pattern as
      // planRequests). 'team' scope is captain-only.
      match /mealPlanRequests/{requestId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['requestedBy', 'scope', 'status', 'createdAt'])
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && (request.resource.data.scope == 'self'
              || (request.resource.data.scope == 'team' && isCaptain(teamId)));
        allow update, delete: if false;
      }

      // F3.1: AI strength coach queue — one doc per member (docId == uid), so
      // a re-request simply resets the same doc to 'pending' and the trigger
      // (Admin SDK) overwrites it with the advice. No index, no growth.
      match /strengthAdviceRequests/{memberUid} {
        allow read: if isMember(teamId) && request.auth.uid == memberUid;
        allow create, update: if isMember(teamId)
          && request.auth.uid == memberUid
          && request.resource.data.keys().hasOnly(['requestedBy', 'status', 'createdAt'])
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow delete: if false;
      }

      // F13B/F6: function-written fuelling aggregate — counts + latest review
      // verdict only; raw meals never cross members (spec §3).
      match /fuelling/{memberUid} {
        allow read: if isMember(teamId);
        allow write: if false;
      }
    }

    // §2.5: code → team lookup. Readable by any signed-in user (that is the
    // point of a join code); writable only alongside the team it references.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow update: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(teamPath(request.resource.data.teamId)).data.createdBy == request.auth.uid
        && getAfter(teamPath(request.resource.data.teamId)).data.inviteCode == code;
      allow delete: if signedIn()
        && get(teamPath(resource.data.teamId)).data.createdBy == request.auth.uid;
    }

    // F10: stored forecasts, shared read-only reference data.
    match /weather/{date} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
