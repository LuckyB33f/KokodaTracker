# Copy to .env.local and fill in from: firebase apps:sdkconfig web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JS API key (F4 live map). Restrict by HTTP referrer in Google
# Cloud Console (spec R3). Recording works without it — the map is optional.
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to point Auth/Firestore at local emulators (npm run emulators)
VITE_USE_EMULATORS=false
